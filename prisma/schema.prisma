// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id       BigInt    @id @default(autoincrement())
  name     String
  leader   String
  users    User[]
  balances Balance[]
}

model Website {
  id           BigInt        @id @default(autoincrement())
  name         String
  dailyReports DailyReport[]
  balances     Balance[]
}

model Balance {
  id        BigInt   @id @default(autoincrement())
  teamId    BigInt
  team      Team     @relation(fields: [teamId], references: [id])
  websiteId BigInt
  website   Website  @relation(fields: [websiteId], references: [id])
  balance   Decimal  @default(0) @db.Decimal

  @@unique([teamId, websiteId])
  @@index([websiteId])
}

model DailyReport {
  id          BigInt    @id @default(autoincrement())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  websiteId   BigInt?
  website     Website?  @relation(fields: [websiteId], references: [id])
  date        DateTime  @db.Date
  startAmount Decimal   @db.Decimal
  endAmount   Decimal   @db.Decimal
  submittedAt DateTime? @default(now())

  @@index([userId, date], name: "idx_reports_user_date")
  @@index([websiteId, date], name: "idx_reports_website_date")
}

model User {
  id              String        @id
  name            String
  email           String        @unique
  emailVerified   Boolean       @default(false)
  image           String?
  role            String        @default("user")
  username        String?       @unique
  displayUsername String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  teamId          BigInt?
  team            Team?         @relation(fields: [teamId], references: [id])
  dailyReports    DailyReport[]
  sessions        Session[]
  accounts        Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}
